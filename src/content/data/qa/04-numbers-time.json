          ]
        },
        "answers": [
          {
            "text": "نەخێر، ئەمڕۆ پێنجشەممەیە.",
            "latin": "nexêr, emřo pêncşemmeye.",
            "tokens": [
              { "text": "نەخێر،", "latin": "nexêr,", "gloss": { "en": "no", "sv": "nej" }, "concept": "no" },
              { "text": "ئەمڕۆ", "latin": "emřo", "gloss": { "en": "today", "sv": "idag" }, "concept": "today" },
              {
                "text": "پێنجشەممەیە.",
