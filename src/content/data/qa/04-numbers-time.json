            { "text": "جمعه", "latin": "jom'e", "gloss": { "en": "Friday", "sv": "fredag" }, "concept": "friday" },
            { "text": "است؟", "latin": "ast?", "gloss": { "en": "is", "sv": "är" }, "concept": "to-be", "morph": "be.PRS.3SG" }
          ]
        },
        "answers": [
          {
            "text": "نه، امروز پنجشنبه است.",
            "latin": "na, emruz panjshanbe ast.",
            "tokens": [
              { "text": "نه،", "latin": "na,", "gloss": { "en": "no", "sv": "nej" }, "concept": "no" },
              { "text": "امروز", "latin": "emruz", "gloss": { "en": "today", "sv": "idag" }, "concept": "today" },
              { "text": "پنجشنبه", "latin": "panjshanbe", "gloss": { "en": "Thursday", "sv": "torsdag" }, "concept": "thursday" },
              { "text": "است.", "latin": "ast.", "gloss": { "en": "is", "sv": "är" }, "concept": "to-be", "morph": "be.PRS.3SG" }
            ],
            "translation": { "en": "No, today is Thursday.", "sv": "Nej, idag är det torsdag." }
          },
          {
            "text": "بله، امروز جمعه است.",
            "latin": "bale, emruz jom'e ast.",
            "translation": { "en": "Yes, today is Friday.", "sv": "Ja, idag är det fredag." }
          },
          {
            "text": "نه، فردا جمعه است.",
            "latin": "na, fardâ jom'e ast.",
            "translation": { "en": "No, tomorrow is Friday.", "sv": "Nej, i morgon är det fredag." }
          },
          {
            "text": "نه، فردا جمعه‌ست.",
            "latin": "na, fardâ jom'e-st.",
            "translation": { "en": "No, tomorrow is Friday.", "sv": "Nej, i morgon är det fredag." }
          }
        ],
        "sources": [{ "source": "author" }]
      }
    },
