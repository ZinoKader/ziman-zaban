                "gloss": { "en": "is Thursday", "sv": "är torsdag" },
                "concept": "thursday",
                "morph": "Thursday-COP.3SG"
              }
            ],
            "translation": { "en": "No, today is Thursday.", "sv": "Nej, idag är det torsdag." }
          },
          { "text": "بەڵێ، ئەمڕۆ هەینییە.", "latin": "bełê, emřo heynîye.", "translation": { "en": "Yes, today is Friday.", "sv": "Ja, idag är det fredag." } },
          {
            "text": "نا، سبەی هەینییە.",
            "latin": "na, sibey heynîye.",
            "translation": { "en": "No, tomorrow is Friday.", "sv": "Nej, i morgon är det fredag." }
          }
        ],
        "sources": [{ "source": "tatoeba" }, { "source": "author" }]
      },
      "fa": {
        "question": {
          "text": "امروز جمعه است؟",
