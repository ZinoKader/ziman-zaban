                "text": "خوشکێکم",
                "latin": "xuşkêkim",
                "gloss": { "en": "a sister of mine", "sv": "en syster till mig" },
                "concept": "sister",
                "morph": "sister-INDF-1SG"
              },
              {
                "text": "هەیە.",
                "latin": "heye.",
                "gloss": { "en": "there is (= I have)", "sv": "det finns (= jag har)" },
                "concept": "to-have",
                "morph": "exist.PRS.3SG"
              }
            ],
            "translation": { "en": "Yes, I have a sister.", "sv": "Ja, jag har en syster." }
          },
          {
            "text": "برام نییە، بەڵام دوو خوشکم هەیە.",
            "latin": "biram nîye, bełam dû xuşkim heye.",
            "translation": { "en": "I don't have a brother, but I have two sisters.", "sv": "Jag har ingen bror, men jag har två systrar." }
          },
          {
            "text": "نەخێر، خوشک و برام نییە.",
            "latin": "nexêr, xuşk û biram nîye.",
            "translation": { "en": "No, I don't have any brothers or sisters.", "sv": "Nej, jag har inga syskon." }
          }
