            { "text": "خواهر", "latin": "khâhar", "gloss": { "en": "sister", "sv": "syster" }, "concept": "sister" },
            { "text": "و", "latin": "o", "gloss": { "en": "and", "sv": "och" } },
            { "text": "برادر", "latin": "barâdar", "gloss": { "en": "brother", "sv": "bror" }, "concept": "brother" },
            { "text": "دارید؟", "latin": "dârid?", "gloss": { "en": "do you have", "sv": "har ni" }, "concept": "to-have", "morph": "have.PRS-2PL" }
          ]
        },
        "answers": [
          {
            "text": "بله، یک خواهر دارم.",
            "latin": "bale, yek khâhar dâram.",
            "tokens": [
              { "text": "بله،", "latin": "bale,", "gloss": { "en": "yes", "sv": "ja" }, "concept": "yes" },
              { "text": "یک", "latin": "yek", "gloss": { "en": "a (one)", "sv": "en" } },
              { "text": "خواهر", "latin": "khâhar", "gloss": { "en": "sister", "sv": "syster" }, "concept": "sister" },
              { "text": "دارم.", "latin": "dâram.", "gloss": { "en": "I have", "sv": "jag har" }, "concept": "to-have", "morph": "have.PRS-1SG" }
            ],
            "translation": { "en": "Yes, I have a sister.", "sv": "Ja, jag har en syster." }
          },
          {
            "text": "برادر ندارم، ولی دو خواهر دارم.",
            "latin": "barâdar nadâram, vali do khâhar dâram.",
            "translation": { "en": "I don't have a brother, but I have two sisters.", "sv": "Jag har ingen bror, men jag har två systrar." }
          },
          {
            "text": "نه، تک‌فرزندم.",
            "latin": "na, tak-farzandam.",
            "translation": { "en": "No, I'm an only child.", "sv": "Nej, jag är enda barnet." }
